<Window x:Class="InvoiceSystem_Group3.Main.wndMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceSystem_Group3"
        mc:Ignorable="d"
        Title="Walmart Invoice System" Height="450" Width="800"
		Loaded="Window_Loaded">
	    
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F1F1F1">
            <MenuItem Header="File">
                <MenuItem Header="Search for Invoice" Click="SearchInvoiceBtn_Click"/>
                <MenuItem Header="Update Items Table" Click="ManageItemsBtn_Click"/>
            </MenuItem>
        </Menu>


        <Grid Background="#0071CE">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Walmart Invoice System" FontSize="32" Foreground="White" FontWeight="Bold" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Search Invoices" Width="130" Height="40" Margin="10" Click="SearchInvoiceBtn_Click"/>
                    <Button Content="Manage Items" Width="130" Height="40" Margin="10" Click="ManageItemsBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
