<Window x:Class="InvoiceSystem_Group3.Items.wndItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceSystem_Group3"
        mc:Ignorable="d"
        Title="Manage Items" Height="450" Width="650">
    <Border Padding="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" Name="dgInventoryItems" AutoGenerateColumns="True" Margin="0,0,20,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="Item Code:" Margin="0,0,0,5"/>
                <TextBox Name="txtItemCode" Height="25" Margin="0,0,0,15"/>

                <TextBlock Text="Description:" Margin="0,0,0,5"/>
                <TextBox Name="txtItemDesc" Height="25" Margin="0,0,0,15"/>

                <TextBlock Text="Unit Cost:" Margin="0,0,0,5"/>
                <TextBox Name="txtItemCost" Height="25" Margin="0,0,0,25"/>

                <Button Content="Add New Item" Height="30" Margin="0,5"/>
                <Button Content="Update Selected" Height="30" Margin="0,5"/>
                <Button Content="Delete Item" Height="30" Margin="0,5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
